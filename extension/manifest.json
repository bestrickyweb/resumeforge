{
  "manifest_version": 3,
  "name": "ResumePrime � Save Jobs",
  "version": "1.0",
  "description": "Save job postings to your ResumePrime tracker from any site.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to ResumePrime"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}

